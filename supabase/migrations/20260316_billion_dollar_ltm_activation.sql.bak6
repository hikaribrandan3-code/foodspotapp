-- =============================================================================
-- SECTION 9: VERIFICATION
-- =============================================================================

DO $$
DECLARE
    v_count INTEGER;
BEGIN
    -- Verify pgvector
    SELECT COUNT(*) INTO v_count FROM pg_extension WHERE extname = 'vector';
    IF v_count = 0 THEN
        RAISE EXCEPTION '❌ pgvector extension not found';
    END IF;
    RAISE NOTICE '✅ pgvector extension active';

    -- Verify tables
    SELECT COUNT(*) INTO v_count FROM information_schema.tables 
    WHERE table_name IN ('ai_master_memory', 'agent_registry', 'captain_laws', 
                         'ai_conversations', 'ai_knowledge', 'ai_strategies');
    IF v_count < 6 THEN
        RAISE EXCEPTION '❌ Only % of 6 core tables created', v_count;
    END IF;
    RAISE NOTICE '✅ All 6 core LTM tables created';

    -- Verify agents
    SELECT COUNT(*) INTO v_count FROM agent_registry WHERE status = 'active';
    RAISE NOTICE '✅ % swarm agents registered and active', v_count;

    -- Verify laws
    SELECT COUNT(*) INTO v_count FROM captain_laws WHERE is_active = true;
    RAISE NOTICE '✅ % Captain Laws loaded', v_count;

    RAISE NOTICE '🧠 SYNTHETIC NERVOUS SYSTEM: ONLINE';
    RAISE NOTICE '🚀 SWARM STATUS: VANGUARD-READY';
END $$;
